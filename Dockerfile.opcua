FROM python:3.12-alpine

WORKDIR /app

# asyncua pulls cryptography, which ships musllinux wheels for amd64 and arm64,
# so no compiler is needed. pymodbus is not installed: sim.model and
# sim.points are protocol-free.
RUN pip install --no-cache-dir "asyncua==1.1.*" "pyyaml>=6.0"

COPY sim/ ./sim/

EXPOSE 4840

CMD ["python", "-m", "sim.opcua_server"]
